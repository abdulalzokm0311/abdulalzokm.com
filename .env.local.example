# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions get delivered.
CONTACT_TO_EMAIL=abdulalzokm@gmail.com

# The "from" address Resend sends as.
# Until you verify a domain in Resend, leave this as the shared onboarding sender.
# After verifying abdulalzokm.com, change to something like: Portfolio <hello@abdulalzokm.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Canonical site URL, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://abdulalzokm.com

# Password for the two gated RBC case studies. They share one password.
#
# Unset means locked for everyone. The gate fails closed on purpose, because
# the pages it covers are internal RBC work that has not shipped, and an
# unset variable must not mean "open to the world".
#
# Set it in .env.local for development and in your Vercel project settings for
# production. Changing it signs out everyone who has already unlocked.
CASE_STUDY_PASSWORD=
