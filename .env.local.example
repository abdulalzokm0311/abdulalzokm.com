# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions get delivered.
CONTACT_TO_EMAIL=abdulalzokm@gmail.com

# The "from" address Resend sends as.
# Until you verify a domain in Resend, leave this as the shared onboarding sender.
# After verifying abdulalzokm.com, change to something like: Portfolio <hello@abdulalzokm.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Canonical site URL, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://abdulalzokm.com
